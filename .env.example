# ============================================================================
# VisionGuard configuration
# Copy to .env and adjust.  NEVER commit a real .env.
# ============================================================================

# ---------------------------------------------------------------- application
APP_NAME=VisionGuard
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production | test
DEBUG=true
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------ database
# Host ports are shifted (5434/6380) so VisionGuard does not collide with a
# locally installed PostgreSQL/Redis.
DATABASE_URL=postgresql+psycopg://visionguard:visionguard@localhost:5434/visionguard
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

POSTGRES_USER=visionguard
POSTGRES_PASSWORD=visionguard
POSTGRES_DB=visionguard
POSTGRES_HOST_PORT=5434

# --------------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6380/0
REDIS_HOST_PORT=6380

# ---------------------------------------------------------------- auth / jwt
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production-this-is-not-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Fernet key for encrypting camera credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------- cors
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -------------------------------------------------------------------- vision
YOLO_MODEL_PATH=./yolo26n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=auto                 # auto | cpu | cuda | cuda:0
YOLO_IMAGE_SIZE=640
VISION_FPS=10
VISION_FRAME_QUEUE_SIZE=8
TRACKER_TYPE=bytetrack           # bytetrack | botsort

# ------------------------------------------------------------------- storage
VIDEO_STORAGE_PATH=./data/media
EVIDENCE_STORAGE_PATH=./data/evidence
EVENT_RETENTION_DAYS=90
EVIDENCE_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=30

# Event evidence: snapshot + thumbnail + short clip captured when a
# significant event (alert-worthy, i.e. severity >= MEDIUM) fires.
EVIDENCE_CAPTURE_ENABLED=true
EVIDENCE_CLIP_ENABLED=true
EVIDENCE_PRE_SECONDS=4.0
EVIDENCE_POST_SECONDS=4.0
EVIDENCE_CLIP_FPS=8.0
EVIDENCE_THUMBNAIL_WIDTH=320

# Periodic sweep: deletes evidence past expires_at and prunes expired tokens.
RETENTION_SWEEP_ENABLED=true
RETENTION_SWEEP_INTERVAL_HOURS=6

# -------------------------------------------------------------------- events
LOITERING_THRESHOLD_SECONDS=60
LINE_CROSSING_COOLDOWN_SECONDS=3
POS_CORRELATION_WINDOW_SECONDS=120

# ------------------------------------------------------------------- logging
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console               # console | json

# ---------------------------------------------------------------- locale/tz
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
DEFAULT_CURRENCY=TZS
DEFAULT_LOCALE=en

# --------------------------------------------------------------- rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=300

# ----------------------------------------------------------------- edge mode
EDGE_MODE=false
EDGE_CLOUD_API_URL=
EDGE_API_KEY=
EDGE_QUEUE_PATH=./data/edge_queue.db

# ------------------------------------------------------------------ frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
